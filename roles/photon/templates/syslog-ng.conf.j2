# NOTE: this file managed by ansible (photon-os-tools). All changes will be overwritten.

@version: current
@include "scl.conf"

source s_local {
	# The systemd journal, read directly. The old
	# unix-dgram("/run/systemd/journal/syslog") source received nothing on
	# Photon OS 5: syslog.socket isn't started there, so the socket never
	# exists and syslog-ng disabled the source at startup.
	system();
	internal();
};

{% if syslog_local_file %}
destination d_local {
	file("{{ syslog_local_file }}");
};
{% endif %}

{% if syslog_remote_server and syslog_remote_port %}
destination d_remote {
	syslog("{{ syslog_remote_server }}" transport("{{ syslog_remote_transport }}") port({{ syslog_remote_port }})
{% if syslog_disk_buffer_bytes | int > 0 %}
		# Holds messages through a remote outage instead of dropping them.
		disk-buffer(reliable(no) disk-buf-size({{ syslog_disk_buffer_bytes | int }}))
{% endif %}
	);
};
{% endif %}

log {
	source(s_local);
{% if syslog_local_file %}
	destination(d_local);
{% endif %}
{% if syslog_remote_server and syslog_remote_port %}
	destination(d_remote);
{% endif %}
};
